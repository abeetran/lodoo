<odoo>
    <template id="authentik_login_page" inherit_id="web.login" name="Authentik SSO Login Only">
        <!-- Thay form email/password bằng một nút redirect OIDC (route: auth_authentik_sso) -->
        <xpath expr="//form[contains(@class,'oe_login_form')]" position="replace">
            <div class="oe_login_form">
                <a t-att-href="'/auth/authentik/login'" class="btn btn-primary w-100">
                    Login with Authentik
                </a>
            </div>
        </xpath>
        <!-- Tránh nút trùng từ auth_authentik_sso (nếu cả hai module cùng cài) -->
        <xpath expr="//div[contains(@class,'o_login_auth')]" position="replace"/>
    </template>
</odoo>
