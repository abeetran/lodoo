<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <template
        id="odoo_login"
        name="Odoo Login">

        <t t-call="web.login_layout">

            <form
                action="/web/odoo_login_post"
                method="post"
                class="oe_login_form">

                <input
                    type="hidden"
                    name="csrf_token"
                    t-att-value="request.csrf_token()"/>

                <h3 class="text-center mb-4">
                    Admin Login
                </h3>

                <div class="mb-3">
                    <input
                        type="text"
                        name="login"
                        t-att-value="login"
                        class="form-control"
                        placeholder="Login"
                        required="required"/>
                </div>

                <div class="mb-3">
                    <input
                        type="password"
                        name="password"
                        class="form-control"
                        placeholder="Password"
                        required="required"/>
                </div>

                <button
                    type="submit"
                    class="btn btn-primary w-100">
                    Đăng nhập
                </button>

            </form>

        </t>

    </template>

</odoo>