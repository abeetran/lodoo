<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_view_crall_material" model="ir.ui.view">
        <field name="name">product.template.form.crall.material</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="crall_supplier_id"/>
                <field name="crall_supplier_code"/>
            </xpath>
        </field>
    </record>
</odoo>