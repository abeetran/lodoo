<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_crall_material" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.crall.material</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Craw Data" name="crall_material">
                    <block title="HanoiCheck supplier API">
                        <setting string="API URL">
                            <field name="crall_supplier_api_url"/>
                        </setting>
                        <setting string="Bearer token">
                            <field name="crall_supplier_api_token" password="True"/>
                        </setting>
                        <setting string="Referer">
                            <field name="crall_supplier_api_referer"/>
                        </setting>
                        <setting string="Sub-supplier API URL">
                            <field name="crall_sub_supplier_api_url"/>
                        </setting>
                        <setting string="School API URL">
                            <field name="crall_school_api_url"/>
                        </setting>
                    </block>
                    <block title="HNCK API (token)">
                        <setting string="API base URL">
                            <field name="crall_hnck_api_base"/>
                        </setting>
                        <setting string="Grant type">
                            <field name="crall_hnck_grant_type"/>
                        </setting>
                        <setting string="Client ID">
                            <field name="crall_hnck_client_id"/>
                        </setting>
                        <setting string="Client secret">
                            <field name="crall_hnck_client_secret" password="True"/>
                        </setting>
                        <setting string="HMAC secret">
                            <field name="crall_hnck_hmac_secret" password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>