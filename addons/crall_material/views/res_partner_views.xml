<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_tree_crall_sub_supplier" model="ir.ui.view">
        <field name="name">res.partner.tree.crall.sub.supplier</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <header>
                    <button
                        name="action_sync_crall_sub_suppliers_list"
                        type="object"
                        string="Lấy dữ liệu sub-suppliers"
                    />
                </header>
                <field name="ref" string="Mã nhà cung cấp" optional="show"/>
                <field name="crall_sub_supplier_code" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_crall_sub_supplier" model="ir.ui.view">
        <field name="name">res.partner.form.crall.sub.supplier</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="ref" string="Mã nhà cung cấp"/>
                <field name="crall_sub_supplier_id" readonly="1"/>
                <field name="crall_sub_supplier_code" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
