<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="crall_material_sync_wizard_view_form" model="ir.ui.view">
        <field name="name">crall.material.sync.wizard.form</field>
        <field name="model">crall.material.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Crall Materials">
                <sheet>
                    <group>
                        <field name="token" password="True"/>
                        <field name="page"/>
                        <button
                            name="action_sync"
                            type="object"
                            string="Cập nhật danh mục Thực phẩm chuẩn"
                            class="btn-primary"
                            colspan="2"
                        />
                        <button
                            name="action_sync_sub_suppliers"
                            type="object"
                            string="Lấy sub-suppliers theo trang"
                            class="btn-secondary"
                        />
                        <button
                            name="action_sync_schools"
                            type="object"
                            string="Cập nhật danh sách trường"
                            class="btn-secondary"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>