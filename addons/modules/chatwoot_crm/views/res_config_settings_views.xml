<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_chatwoot_crm" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.chatwoot.crm</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Chatwoot CRM" string="Chatwoot CRM">
                    <h2>Chatwoot CRM</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="chatwoot_auto_create_lead"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="chatwoot_auto_create_lead"/>
                                <div class="text-muted">Create a CRM lead when Chatwoot sends a webhook that cannot be matched.</div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <div class="row">
                                    <div class="col-12">
                                        <label for="chatwoot_base_url"/>
                                        <field name="chatwoot_base_url" placeholder="https://omnichat.zflux.cloud"/>
                                    </div>
                                    <div class="col-12 mt8">
                                        <label for="chatwoot_account_id"/>
                                        <field name="chatwoot_account_id" placeholder="1"/>
                                    </div>
                                    <div class="col-12 mt8">
                                        <label for="chatwoot_api_access_token"/>
                                        <field name="chatwoot_api_access_token" password="True" placeholder="Profile API access token"/>
                                    </div>
                                    <div class="col-12 mt8">
                                        <label for="chatwoot_inbox_id"/>
                                        <field name="chatwoot_inbox_id" placeholder="Numeric inbox id"/>
                                    </div>
                                    <div class="col-12 mt8">
                                        <label for="chatwoot_inbox_identifier"/>
                                        <field name="chatwoot_inbox_identifier" placeholder="API inbox identifier"/>
                                    </div>
                                    <div class="col-12 mt8">
                                        <label for="chatwoot_webhook_secret"/>
                                        <field name="chatwoot_webhook_secret" password="True" placeholder="Optional shared secret"/>
                                    </div>
                                    <div class="col-12 mt8 text-muted">
                                        Webhook URL: /chatwoot/webhook
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
