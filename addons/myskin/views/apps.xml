<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action Apps custom -->

    <record id="myskin_apps_action" model="ir.actions.act_window">
        <field name="name">Apps</field>
        <field name="res_model">ir.module.module</field>
        <field name="view_mode">kanban,tree,form</field>

        <field name="domain">
            [
                '|',
                ('state','=','installed'),
                ('name','=ilike','zent_%')
            ]
        </field>

        <field name="context">
            {
                'search_default_installed': 1
            }
        </field>
    </record>

    <!-- Override menu Apps -->

    <record id="base.menu_module_tree" model="ir.ui.menu">
        <field name="action"
               ref="myskin.myskin_apps_action"/>
    </record>

</odoo>