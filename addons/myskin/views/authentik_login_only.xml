<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Gỡ view cũ inherit web.login + xpath //form (gây ParseError khi upgrade) -->
    <delete model="ir.ui.view" id="authentik_login_page"/>

    <!-- auth_signup xpath vào button/form — tắt khi chỉ dùng SSO -->
    <record id="auth_signup.login" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <!-- myskin thay toàn bộ nội dung login — không cần nút thêm từ auth_authentik_sso -->
    <record id="auth_authentik_sso.authentik_login_button" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <template id="authentik_login_only" inherit_id="web.login" name="Authentik login only" priority="99">
        <xpath expr="//t[@t-call='web.login_layout']" position="replace">
            <t t-call="web.login_layout">
                <div class="text-center oe_authentik_login_only py-3">
                    <a href="/auth/authentik/login" class="btn btn-primary btn-lg w-100">
                        Login with Authentik
                    </a>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
