<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="sequence_kitchen_plan" model="ir.sequence">
        <field name="name">Kế hoạch sản xuất bếp</field>
        <field name="code">set_top_menu.kitchen.plan</field>
        <field name="prefix">PROD/%(year)s/%(month)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_catering_order" model="ir.sequence">
        <field name="name">Đơn phục vụ hằng ngày</field>
        <field name="code">set_top_menu.sale.order</field>
        <field name="prefix">ORD/%(year)s/%(month)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
