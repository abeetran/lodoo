<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t
        t-inherit="web.NavBar"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath
            expr="//nav[contains(@class, 'o_main_navbar')]"
            position="inside"
        >
            <div class="o_custom_navbar">
                <div class="o_custom_navbar_items">
                    <t
                        t-foreach="customNavItems"
                        t-as="item"
                        t-key="item.id"
                    >
                        <div
                            class="o_custom_navbar_item"
                            t-att-data-item-id="item.id"
                            t-on-click="() => this.onCustomNavClick(item)"
                        >
                            <span class="o_custom_navbar_icon">
                                <i
                                    t-att-class="'fa ' + item.icon"
                                />
                            </span>

                            <span class="o_custom_navbar_label">
                                <t t-esc="item.label"/>
                            </span>
                            <i t-if="item.children" class="fa fa-caret-down o_custom_navbar_caret"/>
                            <div t-if="item.children" class="o_custom_navbar_submenu">
                                <t t-foreach="item.children" t-as="child" t-key="child.id">
                                    <button type="button"
                                            class="o_custom_navbar_submenu_item"
                                            t-on-click.stop="() => this.onCustomNavClick(child)">
                                        <i t-att-class="'fa ' + child.icon"/>
                                        <span><t t-esc="child.label"/></span>
                                    </button>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </xpath>
    </t>
</templates>
