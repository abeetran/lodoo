<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dùng model khách hàng chuẩn của Odoo để đảm bảo đầy đủ CRUD và tương thích. -->
    <record id="action_client_management" model="ir.actions.act_window">
        <field name="name">Clients Management</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('customer_rank', '&gt;', 0)]</field>
        <field name="context">{
            'default_customer_rank': 1,
            'res_partner_search_mode': 'customer'
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Thêm client mới</p>
            <p>Quản lý thông tin và liên hệ của clients.</p>
        </field>
    </record>
</odoo>