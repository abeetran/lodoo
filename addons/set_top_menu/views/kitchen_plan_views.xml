<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kitchen_plan_tree" model="ir.ui.view">
        <field name="name">set_top_menu.kitchen.plan.tree</field>
        <field name="model">set_top_menu.kitchen.plan</field>
        <field name="arch" type="xml">
            <tree string="Kế hoạch sản xuất">
                <field name="name"/>
                <field name="production_date"/>
                <field name="meal_type_id"/>
                <field name="total_items"/>
                <field name="total_servings"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-primary="state == 'progress'"
                       decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>

    <record id="view_kitchen_plan_form" model="ir.ui.view">
        <field name="name">set_top_menu.kitchen.plan.form</field>
        <field name="model">set_top_menu.kitchen.plan</field>
        <field name="arch" type="xml">
            <form string="Kế hoạch sản xuất">
                <header>
                    <button name="action_generate_from_orders" type="object"
                            string="Tạo từ đơn hàng" icon="fa-magic"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Xác nhận"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Bắt đầu"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_done" type="object" string="Hoàn tất"
                            class="btn-primary" invisible="state != 'progress'"/>
                    <button name="action_reset_draft" type="object" string="Đưa về nháp"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_orders" type="object" class="oe_stat_button"
                                icon="fa-cutlery" invisible="order_count == 0">
                            <field name="order_count" widget="statinfo" string="Đơn hàng"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Mã kế hoạch"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="production_date" readonly="state != 'draft'"/>
                            <field name="meal_type_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="total_items" readonly="1"/>
                            <field name="total_servings" readonly="1"/>
                            <field name="progress" widget="progressbar" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chi tiết sản xuất" name="production_lines">
                            <field name="line_ids" nolabel="1" readonly="state == 'done'">
                                <tree editable="bottom">
                                    <control><create string="Thêm món"/></control>
                                    <field name="sequence" widget="handle"/>
                                    <field name="meal_type_id" readonly="1"/>
                                    <field name="menu_item_id" readonly="parent.state != 'draft'"/>
                                    <field name="food_category" widget="badge" readonly="1"
                                           decoration-success="food_category in ('vegetarian', 'vegan')"/>
                                    <field name="quantity" readonly="parent.state != 'draft'"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="prepared_quantity"/>
                                    <field name="state" widget="badge"
                                           decoration-muted="state == 'pending'"
                                           decoration-warning="state == 'progress'"
                                           decoration-success="state == 'done'"/>
                                    <button name="action_start" type="object" string="Bắt đầu"
                                            icon="fa-play"
                                            invisible="state != 'pending' or parent.state not in ('confirmed', 'progress')"/>
                                    <button name="action_done" type="object" string="Hoàn tất"
                                            icon="fa-check"
                                            invisible="state == 'done' or parent.state not in ('confirmed', 'progress')"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Ghi chú" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kitchen_plan_search" model="ir.ui.view">
        <field name="name">set_top_menu.kitchen.plan.search</field>
        <field name="model">set_top_menu.kitchen.plan</field>
        <field name="arch" type="xml">
            <search string="Tìm kế hoạch sản xuất">
                <field name="name"/>
                <field name="production_date"/>
                <field name="meal_type_id"/>
                <filter name="draft" string="Nháp" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Đã xác nhận" domain="[('state', '=', 'confirmed')]"/>
                <filter name="progress" string="Đang thực hiện" domain="[('state', '=', 'progress')]"/>
                <filter name="done" string="Hoàn tất" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_date" string="Ngày sản xuất"
                            context="{'group_by': 'production_date'}"/>
                    <filter name="group_meal" string="Loại bữa ăn"
                            context="{'group_by': 'meal_type_id'}"/>
                    <filter name="group_state" string="Trạng thái"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kitchen_plans" model="ir.actions.act_window">
        <field name="name">Kế hoạch sản xuất</field>
        <field name="res_model">set_top_menu.kitchen.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_kitchen_plan_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tạo kế hoạch sản xuất mới</p>
            <p>Lập kế hoạch món ăn và theo dõi tiến độ thực hiện trong bếp.</p>
        </field>
    </record>
</odoo>
