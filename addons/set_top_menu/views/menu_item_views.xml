<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_menu_item_tree" model="ir.ui.view">
        <field name="name">set_top_menu.menu.item.tree</field>
        <field name="model">set_top_menu.menu.item</field>
        <field name="arch" type="xml">
            <tree string="Danh sách món ăn">
                <header>
                    <button name="action_push_supplier_dishes" type="object"
                            string="Đồng bộ" icon="fa-upload" class="btn-primary"/>
                </header>
                <field name="image_1920" widget="image" options="{'size': [48, 48]}"/>
                <field name="item_code"/>
                <field name="name"/>
                <field name="food_category"/>
                <field name="serving_size"/>
                <field name="serving_uom_id"/>
                <field name="cost_per_serving" sum="Tổng"/>
                <field name="currency_id" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="view_menu_item_form" model="ir.ui.view">
        <field name="name">set_top_menu.menu.item.form</field>
        <field name="model">set_top_menu.menu.item</field>
        <field name="arch" type="xml">
            <form string="Món ăn">
                <sheet>
                    <widget name="web_ribbon" title="Đã lưu trữ" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image_1920'}"/>
                    <div class="oe_title">
                        <label for="name" string="Tên món"/>
                        <h1><field name="name" placeholder="Ví dụ: Cơm rang"/></h1>
                    </div>
                    <separator string="Bước 1: Thông tin món ăn"/>
                    <group>
                        <group>
                            <field name="item_code" placeholder="Ví dụ: MON-001"/>
                            <field name="process_id" options="{'no_create': True, 'no_create_edit': True}"
                                   domain="[('product_type', '=', 'thuc_an')]"
                                   readonly="id > 0" required="1"/>
                            <field name="product_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="serving_size"/>
                            <field name="serving_uom_id"/>
                            <field name="cost_per_serving" readonly="1"/>
                            <field name="sale_price"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="age_group_id" required="1"
                               domain="[('supplier_age_id', '!=', False)]"/>
                        <field name="supplier_procedure_code" readonly="1"/>
                        <field name="supplier_age_group_id" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Nguyên liệu công thức" name="ingredients">
                            <field name="ingredient_ids" nolabel="1">
                                <tree editable="bottom">
                                    <control><create string="Thêm nguyên liệu"/></control>
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="unit_cost" optional="hide"/>
                                    <field name="cost" readonly="1" sum="Chi phí mỗi khẩu phần"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Mô tả" name="description">
                            <field name="description" nolabel="1"/>
                        </page>
                        <page string="Cơ sở sản xuất" name="production_sites">
                            <field name="production_site_ids" nolabel="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="address"/>
                                    <field name="phone"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Nhân viên thực hiện" name="employees">
                            <field name="employee_ids" nolabel="1"
                                   options="{'no_create': True}">
                                <tree>
                                    <field name="name"/>
                                    <field name="login"/>
                                    <field name="employee_code"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Ảnh và giấy tờ chứng minh" name="media">
                            <group string="Ảnh món ăn">
                                <field name="dish_image_ids" widget="many2many_binary" nolabel="1"/>
                            </group>
                            <group string="Giấy tờ chứng minh">
                                <field name="dish_document_ids" widget="many2many_binary" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                    <separator string="Bước 2: Quy trình chế biến" invisible="not process_id"/>
                    <field name="stage_line_ids" widget="dish_stage_list" nolabel="1"
                           invisible="not process_id">
                        <!-- Subview tree chỉ để khai báo dữ liệu cần nạp
                             (buộc viewMode="list" để model dùng đúng spec,
                             kể cả tên hiển thị của nhân viên/cơ sở).
                             Widget vẽ giao diện 2 cột, tree này không hiển thị. -->
                        <tree string="Nạp dữ liệu khâu chế biến">
                            <field name="sequence"/>
                            <field name="step_id"/>
                            <field name="step_code"/>
                            <field name="step_name"/>
                            <field name="employee_ids"/>
                            <field name="site_id"/>
                            <field name="info"/>
                            <field name="address"/>
                            <field name="file_ids"/>
                        </tree>
                        <form string="Khâu chế biến">
                            <field name="step_id" invisible="1"/>
                            <field name="step_code" invisible="1"/>
                            <field name="step_name" invisible="1"/>
                            <field name="sequence" invisible="1"/>
                            <field name="employee_ids" widget="many2many_tags" required="1"
                                   options="{'no_create': True}"/>
                            <field name="site_id" options="{'no_create': True}"/>
                            <field name="info" required="1"/>
                            <field name="address"/>
                            <field name="file_ids" widget="many2many_binary" nolabel="1"/>
                        </form>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dish_push_wizard_form" model="ir.ui.view">
        <field name="name">set_top_menu.dish.push.wizard.form</field>
        <field name="model">set_top_menu.dish.push.wizard</field>
        <field name="arch" type="xml">
            <form string="Xác nhận đồng bộ món ăn">
                <sheet>
                    <field name="state" invisible="1"/>
                    <group>
                        <field name="name" readonly="1"/>
                    </group>
                    <group string="Dữ liệu sẽ gửi (JSON)">
                        <field name="payload_text" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Phản hồi từ HNCK" invisible="state != 'done'">
                        <field name="result_text" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_push" string="Xác nhận gửi"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Đóng" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_menu_item_search" model="ir.ui.view">
        <field name="name">set_top_menu.menu.item.search</field>
        <field name="model">set_top_menu.menu.item</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm món ăn">
                <field name="name"/>
                <field name="item_code"/>
                <field name="food_category"/>
                <field name="meal_type_ids"/>
                <field name="dietary_tag_ids"/>
                <filter name="vegetarian" string="Món chay" domain="[('food_category', '=', 'vegetarian')]"/>
                <filter name="vegan" string="Thuần chay" domain="[('food_category', '=', 'vegan')]"/>
                <filter name="archived" string="Đã lưu trữ" domain="[('active', '=', False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_food_category" string="Loại thực phẩm"
                            context="{'group_by': 'food_category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_menu_items" model="ir.actions.act_window">
        <field name="name">Danh sách món ăn</field>
        <field name="res_model">set_top_menu.menu.item</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_menu_item_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tạo món ăn mới</p>
            <p>Khai báo món ăn, thông tin khẩu phần và nguyên liệu công thức.</p>
        </field>
    </record>
</odoo>
