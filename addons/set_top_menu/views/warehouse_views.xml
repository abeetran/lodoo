<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_tree" model="ir.ui.view">
        <field name="name">set_top_menu.warehouse.tree</field>
        <field name="model">set_top_menu.warehouse</field>
        <field name="arch" type="xml">
            <tree string="QL kho" create="0">
                <header>
                    <button name="action_open_create_popup" type="object"
                            string="Thêm mới" icon="fa-plus" class="btn-primary"
                            display="always"/>
                    <button name="action_push_supplier_warehouses" type="object"
                            string="Đồng bộ" icon="fa-upload" class="btn-primary"/>
                </header>
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="address"/>
                <field name="area" optional="show"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="view_warehouse_form" model="ir.ui.view">
        <field name="name">set_top_menu.warehouse.form</field>
        <field name="model">set_top_menu.warehouse</field>
        <field name="arch" type="xml">
            <form string="Kho">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Tên kho"/>
                        <h1><field name="name" placeholder="Ví dụ: Kho Hà Nội"/></h1>
                    </div>
                    <group>
                        <field name="code" placeholder="Ví dụ: KHO-001"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="address" placeholder="Ví dụ: 123 Đường Láng, Hà Nội"/>
                        <field name="area" placeholder="Ví dụ: 500"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_warehouse_form_create" model="ir.ui.view">
        <field name="name">set_top_menu.warehouse.form.create</field>
        <field name="model">set_top_menu.warehouse</field>
        <field name="arch" type="xml">
            <form string="Thêm kho mới">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Tên kho"/>
                        <h1><field name="name" placeholder="Ví dụ: Kho Hà Nội"/></h1>
                    </div>
                    <group>
                        <field name="code" placeholder="Ví dụ: KHO-001"/>
                        <field name="area" placeholder="Ví dụ: 500"/>
                    </group>
                    <group>
                        <field name="address" placeholder="Ví dụ: 123 Đường Láng, Hà Nội"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_warehouse_search" model="ir.ui.view">
        <field name="name">set_top_menu.warehouse.search</field>
        <field name="model">set_top_menu.warehouse</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm kho">
                <field name="name"/>
                <field name="code"/>
                <field name="address"/>
                <filter name="active" string="Đang hoạt động" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Đã lưu trữ" domain="[('active', '=', False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_active" string="Trạng thái"
                            context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_warehouses" model="ir.actions.act_window">
        <field name="name">QL kho</field>
        <field name="res_model">set_top_menu.warehouse</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_warehouse_search"/>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tạo kho mới</p>
            <p>Nhấn Thêm mới để thêm kho với tên, mã, địa chỉ và diện tích.</p>
        </field>
    </record>

    <menuitem
        id="menu_warehouses"
        name="QL kho"
        action="action_warehouses"
        sequence="91"
    />
</odoo>
